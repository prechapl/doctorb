# Firebase Configuration (for local development)
REACT_APP_API_URL=http://localhost:5001/YOUR-PROJECT-ID/us-central1

# For production deployment, this will be set to the Firebase Functions URL
# REACT_APP_API_URL=https://us-central1-YOUR-PROJECT-ID.cloudfunctions.net

# These environment variables need to be set in Firebase Functions config:
# firebase functions:config:set gsuite.client_id="YOUR_CLIENT_ID"
# firebase functions:config:set gsuite.private_key="YOUR_PRIVATE_KEY"