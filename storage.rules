rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow read access to all files
    match /{allPaths=**} {
      allow read: if true;
      // Only allow writes from authenticated users or admin
      allow write: if request.auth != null;
    }
    
    // Public read access for videos
    match /videos/{video} {
      allow read: if true;
    }
    
    // Public read access for images
    match /images/{image} {
      allow read: if true;
    }
  }
}